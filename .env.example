# ==============================================================================
# Razorpay AI Finance Controller — Environment Variables
# ==============================================================================

# Google Gemini API Key (Required for Tier 0 narrative extraction,
# Tier 4 bundle reasoning, and the Settlement Q&A agent).
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Razorpay Test Mode API Credentials (Required only if re-running
# 1_fetch_razorpay_data.py to fetch fresh transactions from Razorpay API).
# Generate from: Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
